{%- liquid
  assign card_product = product
  if settings.card_hover_override != blank and settings.card_hover_override != 'section'
    assign interaction_style = settings.card_hover_override
  endif
  assign card_color = card_color | default: '#F49AC2'
  assign card_index = index | default: 1
  assign loading_strategy = 'lazy'
  if card_index <= 3
    assign loading_strategy = 'eager'
  endif
  assign reveal_index = card_index | minus: 1
  assign reveal_delay = settings.motion_stagger | times: reveal_index
  assign placeholder_index = card_index | modulo: 6
  if placeholder_index == 0
    assign placeholder_index = 6
  endif
  assign card_pet_type = settings.card_pet_type
  if card_pet_type == 'mixed'
    assign pet_remainder = card_index | modulo: 2
    if pet_remainder == 0
      assign card_pet_type = 'dog'
    else
      assign card_pet_type = 'cat'
    endif
  endif
-%}

<article class="product-card pack-interaction--{{ interaction_style | default: 'lift' }}" style="--card-bg: {{ card_color }}; --card-visual: {{ settings.card_visual_color }}; --card-visual-accent: {{ settings.card_visual_accent }}{% if reveal_style != blank and reveal_style != 'none' %}; --pack-reveal-delay: {{ reveal_delay }}ms{% endif %}"{% if reveal_style != blank and reveal_style != 'none' %} data-pack-reveal="{{ reveal_style }}"{% endif %}{% if interaction_style == 'tilt' %} data-pack-tilt{% endif %}>
  {%- if settings.card_pet_style != blank and settings.card_pet_style != 'none' -%}
    {% render 'product-card-pet', pet_style: settings.card_pet_style, pet_type: card_pet_type, pet_position: settings.card_pet_position, pet_size: settings.card_pet_size, pet_color: settings.card_pet_color, pet_detail_color: settings.card_pet_detail_color, pet_motion: settings.card_pet_motion, show_on_mobile: settings.card_pet_show_mobile %}
  {%- endif -%}
  {%- if settings.card_show_hanging_tag and settings.card_hanging_tag_text != blank -%}
    <span class="product-card__hanging-tag" aria-hidden="true">{{ settings.card_hanging_tag_text | escape }}</span>
  {%- endif -%}
  {%- if settings.card_show_sticker and settings.card_sticker_text != blank -%}
    <span class="product-card__playful-sticker" aria-hidden="true">{{ settings.card_sticker_text | escape }}</span>
  {%- endif -%}
  <div class="product-card__media-wrap">
    <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_media -%}
        {{ card_product.featured_media
          | image_url: width: 900
          | image_tag:
            widths: '280, 420, 560, 720, 900',
            sizes: '(min-width: 990px) 25vw, 50vw',
            loading: loading_strategy,
            class: 'product-card__image product-card__image--primary',
            alt: card_product.featured_media.alt | default: card_product.title
        }}
        {%- if settings.card_show_secondary_image and card_product.images.size > 1 -%}
          {{ card_product.images[1]
            | image_url: width: 900
            | image_tag:
              widths: '280, 420, 560, 720, 900',
              sizes: '(min-width: 990px) 25vw, 50vw',
              loading: 'lazy',
              class: 'product-card__image product-card__image--secondary',
              alt: card_product.images[1].alt | default: card_product.title
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'pack-placeholder' }}
      {%- endif -%}
      {%- if settings.card_show_sale_badge and card_product.compare_at_price_max > card_product.price -%}
        <span class="product-card__badge">Save</span>
      {%- endif -%}
    </a>

    {%- if settings.card_enable_quick_add and card_product.available and card_product.has_only_default_variant -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form" data-quick-add>
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="product-card__quick" type="submit" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ card_product.title | escape }}">
          {% render 'icon', icon: 'plus' %}
        </button>
      </form>
    {%- elsif settings.card_enable_quick_add and card_product.available -%}
      <a class="product-card__quick" href="{{ card_product.url }}" aria-label="{{ 'products.product.choose_options' | t }}: {{ card_product.title | escape }}">
        {% render 'icon', icon: 'plus' %}
      </a>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    <div>{%- if settings.card_show_vendor and card_product.vendor != blank -%}<span class="product-card__vendor">{{ card_product.vendor }}</span>{%- endif -%}<a class="product-card__title" href="{{ card_product.url }}">{{ card_product.title }}</a></div>
    <div class="product-card__price">
      {%- if card_product.compare_at_price_max > card_product.price -%}
        <span class="product-card__compare">{{ card_product.compare_at_price_max | money }}</span>
      {%- endif -%}
      <span>{% if card_product.price_varies %}{{ card_product.price_min | money }} – {{ card_product.price_max | money }}{% else %}{{ card_product.price | money }}{% endif %}</span>
      {% render 'unit-price', variant: card_product.selected_or_first_available_variant %}
    </div>
  </div>
</article>
