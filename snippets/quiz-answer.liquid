{%- assign normalized_result_key = result_key | default: 'default' | handleize -%}
{%- if answer_label != blank -%}
  <button class="quiz-answer" type="button" data-quiz-answer data-result-key="{{ normalized_result_key }}">
    <span>{{ answer_label }}</span><span aria-hidden="true">→</span>
  </button>
{%- endif -%}
