{%- liquid
  assign show_face = false
  assign show_tail = false
  if pet_style contains 'face'
    assign show_face = true
  endif
  if pet_style contains 'tail'
    assign show_tail = true
  endif
-%}
<span class="product-card-pet product-card-pet--{{ pet_style }} product-card-pet--{{ pet_type }} product-card-pet--{{ pet_position }} product-card-pet--motion-{{ pet_motion }}{% unless show_on_mobile %} product-card-pet--desktop-only{% endunless %}" style="--card-pet-size: {{ pet_size }}px; --perched-pet-color: {{ pet_color }}; --card-pet-detail: {{ pet_detail_color }};" aria-hidden="true">
  {%- if show_tail -%}
    <svg class="product-card-pet__tail" viewBox="0 0 95 185" role="presentation" focusable="false">
      {%- if pet_type == 'dog' -%}
        <path class="playful-pet__tail-outline" d="M17 16c51 7 67 38 54 67-9 20-34 27-31 51 2 16 18 23 34 17"/><path class="playful-pet__tail-color" d="M17 16c51 7 67 38 54 67-9 20-34 27-31 51 2 16 18 23 34 17"/>
      {%- else -%}
        <path class="playful-pet__tail-outline" d="M15 15c52 4 69 34 61 65-6 24-35 36-31 65 2 17 17 25 33 18"/><path class="playful-pet__tail-color" d="M15 15c52 4 69 34 61 65-6 24-35 36-31 65 2 17 17 25 33 18"/>
      {%- endif -%}
    </svg>
  {%- endif -%}
  {%- if show_face -%}
    {% render 'playful-pet-face', pet_type: pet_type, class: 'product-card-pet__face' %}
  {%- else -%}
    <span class="product-card-pet__paws{% if pet_style == 'single-paw' %} product-card-pet__paws--single{% endif %}"><i></i><i></i></span>
  {%- endif -%}
</span>
