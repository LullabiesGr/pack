<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="gift-card-page">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
