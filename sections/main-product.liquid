{%- liquid
  assign current_variant = product.selected_variant | default: product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign selected_media_id = current_variant.featured_media.id | default: product.featured_media.id
-%}
<section id="MainProduct-{{ section.id }}" class="main-product" data-product-section data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-selected-media-id="{{ selected_media_id }}">
  <div class="main-product__grid page-width">
    <div class="product-gallery-shell" data-product-gallery>
      <div class="product-gallery" data-product-gallery-track>
        {%- for media in product.media -%}
          {%- liquid
            assign media_loading = 'lazy'
            if media.id == selected_media_id or forloop.first
              assign media_loading = 'eager'
            endif
          -%}
          <div class="product-gallery__item" data-media-id="{{ media.id }}">
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 55vw, calc(100vw - 28px)', loading: media_loading, alt: media.alt | default: product.title }}
            {%- else -%}
              {{ media | media_tag: image_size: '1000x', controls: true }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="product-gallery__item">{{ 'product-1' | placeholder_svg_tag: 'pack-placeholder' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}<div class="product-gallery__controls"><button type="button" aria-label="{{ 'products.product.media.previous' | t }}" data-gallery-prev>←</button><span data-gallery-counter aria-live="polite">1 / {{ product.media.size }}</span><button type="button" aria-label="{{ 'products.product.media.next' | t }}" data-gallery-next>→</button></div>{%- endif -%}
    </div>
    <div class="product-details" data-product-details>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}<div class="product-app-block" {{ block.shopify_attributes }}>{% render block %}</div>
          {%- when 'vendor' -%}{%- if product.vendor != blank -%}<p class="pack-eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>{%- endif -%}
          {%- when 'title' -%}<h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {%- when 'price' -%}<div class="product-details__price" role="status" aria-live="polite" {{ block.shopify_attributes }}>{%- if current_variant != blank -%}{%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}<span>{{ current_variant.price | money }}</span>{% render 'unit-price', variant: current_variant %}{%- else -%}<span>{{ 'products.product.unavailable' | t }}</span>{%- endif -%}</div><p class="product-tax-note">{%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- else -%}{{ 'products.product.taxes_at_checkout' | t }}{%- endif -%}</p>
          {%- when 'inventory' -%}<div {{ block.shopify_attributes }}>{%- if block.settings.show_sku -%}<p class="product-details__sku"{% if current_variant.sku == blank %} hidden{% endif %}>{{ 'products.product.sku' | t }}: {{ current_variant.sku }}</p>{%- endif -%}<p class="product-details__inventory{% if current_variant.inventory_management and current_variant.inventory_quantity <= section.settings.low_inventory_threshold %} is-low{% endif %}">{%- if current_variant == blank or current_variant.available == false -%}{{ 'products.product.sold_out' | t }}{%- elsif current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_inventory_threshold -%}{{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}{%- else -%}{{ 'products.product.in_stock' | t }}{%- endif -%}</p></div>
          {%- when 'description' -%}<div class="product-details__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- when 'variant_picker' -%}{%- unless product.has_only_default_variant -%}<div class="product-option-values" data-option-value-selectors {{ block.shopify_attributes }}>{%- for option in product.options_with_values -%}<fieldset class="product-option"><legend>{{ option.name }}: <span data-selected-option>{{ option.selected_value }}</span></legend><div class="product-option__values">{%- for option_value in option.values -%}{%- liquid
            assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
            assign has_swatch = false
            if option_value.swatch.image != blank or option_value.swatch.color != blank
              assign has_swatch = true
            endif
          -%}<input class="visually-hidden" type="radio" id="{{ input_id }}" name="{{ option.name | escape }}-{{ option.position }}" value="{{ option_value | escape }}" data-option-value-id="{{ option_value.id }}" data-product-url="{{ option_value.product_url }}"{% if option_value.selected %} checked{% endif %}><label class="product-option__value{% if has_swatch %} product-option__value--swatch{% endif %}{% unless option_value.available %} is-unavailable{% endunless %}" for="{{ input_id }}" title="{{ option_value | escape }}">{%- if option_value.swatch.image != blank -%}<span class="product-option__swatch" style="background-image:url('{{ option_value.swatch.image | image_url: width: 100 }}')" aria-hidden="true"></span>{%- elsif option_value.swatch.color != blank -%}<span class="product-option__swatch" style="background-color:rgb({{ option_value.swatch.color.rgb }})" aria-hidden="true"></span>{%- endif -%}<span{% if has_swatch %} class="visually-hidden"{% endif %}>{{ option_value }}</span></label>{%- endfor -%}</div></fieldset>{%- endfor -%}</div>{%- endunless -%}
          {%- when 'buy_buttons' -%}<div {{ block.shopify_attributes }}>{%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' -%}{%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}<input type="hidden" name="id" value="{{ current_variant.id }}"{% if current_variant == blank %} disabled{% endif %}>{%- if current_variant.selling_plan_allocations.size > 0 -%}<div class="product-form__option"><label for="SellingPlan-{{ section.id }}">{{ 'products.product.purchase_option' | t }}</label><select id="SellingPlan-{{ section.id }}" name="selling_plan"><option value="">{{ 'products.product.one_time_purchase' | t }}</option>{%- for allocation in current_variant.selling_plan_allocations -%}<option value="{{ allocation.selling_plan.id }}">{{ allocation.selling_plan.name }} — {{ allocation.price | money }}</option>{%- endfor -%}</select></div>{%- endif -%}{%- if product.gift_card? and block.settings.show_gift_recipient -%}{% render 'gift-card-recipient-form', form: form, section: section %}{%- endif -%}<div class="product-form__option"><label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label><input class="quantity-input" id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric"></div><div class="product-form__error" data-product-form-error role="alert" hidden></div><button class="pack-button pack-button--pink" type="submit"{% if current_variant == blank or current_variant.available == false %} disabled{% endif %}>{%- if current_variant == blank -%}{{ 'products.product.unavailable' | t }}{%- elsif current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</button>{%- if block.settings.show_dynamic_checkout -%}{%- unless product.gift_card? -%}{{ form | payment_button }}{%- endunless -%}{%- endif -%}{{ form | payment_terms }}{%- endform -%}</div>
          {%- when 'pickup' -%}<div {{ block.shopify_attributes }}>{%- if current_variant != blank -%}{% render 'pickup-availability', variant: current_variant %}{%- endif -%}</div>
          {%- when 'trust' -%}<div class="ticker" style="margin-top:30px;--ticker-bg:{{ block.settings.background }}" {{ block.shopify_attributes }}><div class="ticker__item">{{ block.settings.text }}</div></div>
          {%- when 'collapsible_tab' -%}<details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}><summary><span class="product-accordion__icon">{% render 'icon', icon: block.settings.icon %}</span>{{ block.settings.heading }}<span class="product-accordion__plus">+</span></summary><div class="product-accordion__content rte">{{ block.settings.content }}</div></details>
          {%- when 'custom_liquid' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if product.featured_media != blank -%}{%- assign recent_product_image = product.featured_media | image_url: width: 720 -%}{%- endif -%}<script type="application/json" data-pack-current-product>{"id":{{ product.id | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{{ recent_product_image | default: '' | json }},"price":{{ product.price | money | json }}}</script>
{% schema %}
{"name":"Main product","settings":[{"type":"range","id":"low_inventory_threshold","min":1,"max":20,"step":1,"label":"Low inventory threshold","default":5}],"blocks":[
  {"type":"@app"},{"type":"vendor","name":"Vendor","limit":1},{"type":"title","name":"Heading","limit":1},{"type":"price","name":"Price","limit":1},{"type":"inventory","name":"Inventory","limit":1,"settings":[{"type":"checkbox","id":"show_sku","label":"Show SKU","default":false}]},{"type":"description","name":"Description","limit":1},{"type":"variant_picker","name":"Variant picker","limit":1},{"type":"buy_buttons","name":"Buy buttons","limit":1,"settings":[{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout","default":true},{"type":"checkbox","id":"show_gift_recipient","label":"Show gift card recipient form","default":true}]},{"type":"pickup","name":"Pickup availability","limit":1},{"type":"trust","name":"Trust message","settings":[{"type":"text","id":"text","label":"Text","default":"Real ingredients · Happiness guaranteed"},{"type":"color","id":"background","label":"Background","default":"#B9E769"}]},{"type":"collapsible_tab","name":"Collapsible row","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good to know"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add ingredients, sizing, care instructions, delivery details or your returns policy.</p>"},{"type":"select","id":"icon","label":"Icon","options":[{"value":"paw","label":"Paw"},{"value":"bone","label":"Bone"},{"value":"heart","label":"Heart"},{"value":"fish","label":"Fish"},{"value":"sparkle","label":"Sparkle"}],"default":"paw"},{"type":"checkbox","id":"open_by_default","label":"Open by default","default":false}]},{"type":"custom_liquid","name":"Custom Liquid","settings":[{"type":"liquid","id":"custom_liquid","label":"Custom Liquid"}]}
]}
{% endschema %}
