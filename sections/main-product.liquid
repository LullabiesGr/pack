<section class="main-product">
  <div class="main-product__grid page-width">
    <div class="product-gallery-shell" data-product-gallery>
      <div class="product-gallery" data-product-gallery-track>
        {%- for media in product.media -%}
          {%- liquid
            assign media_loading = 'lazy'
            if forloop.first
              assign media_loading = 'eager'
            endif
          -%}
          <div class="product-gallery__item">
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 55vw, calc(100vw - 28px)', loading: media_loading, alt: media.alt | default: product.title }}
            {%- else -%}
              {{ media | media_tag: image_size: '1000x', controls: true }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="product-gallery__item">{{ 'product-1' | placeholder_svg_tag: 'pack-placeholder' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__controls">
          <button type="button" aria-label="Previous product image" data-gallery-prev>←</button>
          <span data-gallery-counter>1 / {{ product.media.size }}</span>
          <button type="button" aria-label="Next product image" data-gallery-next>→</button>
        </div>
      {%- endif -%}
    </div>

    <div class="product-details">
      {%- if section.settings.product_show_vendor and product.vendor != blank -%}<p class="pack-eyebrow">{{ product.vendor }}</p>{%- endif -%}
      <h1>{{ product.title }}</h1>
      <div class="product-details__price">
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
        {%- endif -%}
        <span>{{ product.selected_or_first_available_variant.price | money }}</span>
      </div>
      {%- if section.settings.product_show_sku and product.selected_or_first_available_variant.sku != blank -%}<p class="product-details__sku">SKU: {{ product.selected_or_first_available_variant.sku }}</p>{%- endif -%}
      {%- if section.settings.product_show_inventory and product.selected_or_first_available_variant.inventory_management -%}
        <p class="product-details__inventory{% if product.selected_or_first_available_variant.inventory_quantity <= section.settings.product_low_inventory_threshold %} is-low{% endif %}">
          {%- if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= section.settings.product_low_inventory_threshold -%}
            Only {{ product.selected_or_first_available_variant.inventory_quantity }} left
          {%- elsif product.selected_or_first_available_variant.available -%}
            In stock and ready to ship
          {%- else -%}
            Out of stock
          {%- endif -%}
        </p>
      {%- endif -%}
      <div class="product-details__description rte">{{ product.description }}</div>

      {%- form 'product', product, class: 'product-form', data-product-form: '' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="product-form__option">
            <label for="Variant-{{ section.id }}">Options</label>
            <select id="Variant-{{ section.id }}" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                  {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endunless -%}

        {%- if product.selling_plan_groups.size > 0 -%}
          <div class="product-form__option">
            <label for="SellingPlan-{{ section.id }}">Purchase option</label>
            <select id="SellingPlan-{{ section.id }}" name="selling_plan">
              <option value="">One-time purchase</option>
              {%- for allocation in product.selected_or_first_available_variant.selling_plan_allocations -%}
                <option value="{{ allocation.selling_plan.id }}">{{ allocation.selling_plan.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="product-form__option">
          <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <input class="quantity-input" id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">
        </div>
        <button class="pack-button pack-button--pink" type="submit"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
          {%- if product.selected_or_first_available_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
        {{ form | payment_button }}
      {%- endform -%}

      {%- if section.settings.product_show_trust -%}
        <div class="ticker" style="margin-top:30px;--ticker-bg:var(--pack-green)"><div class="ticker__item">Real ingredients <span class="ticker__dot">♥</span> Happiness guaranteed</div></div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="product-accordions">
          {%- for block in section.blocks -%}
            <details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
              <summary><span class="product-accordion__icon">{% render 'icon', icon: block.settings.icon %}</span>{{ block.settings.heading }}<span class="product-accordion__plus">+</span></summary>
              <div class="product-accordion__content rte">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if product.featured_media != blank -%}
  {%- assign recent_product_image = product.featured_media | image_url: width: 720 -%}
{%- endif -%}
<script type="application/json" data-pack-current-product>
  {
    "id": {{ product.id | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "image": {{ recent_product_image | default: '' | json }},
    "price": {{ product.price | money | json }}
  }
</script>

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "checkbox", "id": "product_show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "product_show_sku", "label": "Show SKU", "default": false },
    { "type": "checkbox", "id": "product_show_inventory", "label": "Show inventory status", "default": true },
    { "type": "range", "id": "product_low_inventory_threshold", "min": 1, "max": 20, "step": 1, "label": "Low inventory threshold", "default": 5 },
    { "type": "checkbox", "id": "product_show_trust", "label": "Show trust strip", "default": true }
  ],
  "blocks": [
    {
      "type": "collapsible_tab",
      "name": "Collapsible information",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add ingredients, sizing, care instructions, delivery details or your returns policy.</p>" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "paw", "label": "Paw" }, { "value": "bone", "label": "Bone" }, { "value": "heart", "label": "Heart" }, { "value": "fish", "label": "Fish" }, { "value": "sparkle", "label": "Sparkle" }
        ], "default": "paw" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ]
}
{% endschema %}
