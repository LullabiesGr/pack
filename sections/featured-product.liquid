{%- assign featured_product = section.settings.product -%}
<section class="featured-product section-pad" style="--featured-product-bg:{{ section.settings.background }};--featured-product-text:{{ section.settings.text_color }}"><div class="page-width featured-product__grid">
  <div class="featured-product__media">{%- if featured_product != blank -%}{%- for media in featured_product.media -%}<div class="featured-product__media-item">{%- if media.media_type == 'image' -%}{{ media | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: media.alt | default: featured_product.title }}{%- else -%}{{ media | media_tag: image_size: '900x', controls: true }}{%- endif -%}</div>{%- endfor -%}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'pack-placeholder' }}{%- endif -%}</div>
  <div class="featured-product__content"><p class="pack-eyebrow">{{ section.settings.eyebrow }}</p>{%- if featured_product != blank -%}<h2 class="pack-subheading"><a href="{{ featured_product.url }}">{{ featured_product.title }}</a></h2><div class="product-details__price">{%- if featured_product.compare_at_price > featured_product.price -%}<s>{{ featured_product.compare_at_price | money }}</s>{%- endif -%}<span>{% if featured_product.price_varies %}{{ featured_product.price_min | money }} – {{ featured_product.price_max | money }}{% else %}{{ featured_product.price | money }}{% endif %}</span>{% render 'unit-price', variant: featured_product.selected_or_first_available_variant %}</div><div class="rte">{{ featured_product.description | truncatewords: 45 }}</div>{%- if featured_product.has_only_default_variant -%}{%- form 'product', featured_product, class: 'product-form', data-product-form: '' -%}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}"><button class="pack-button pack-button--pink" type="submit"{% unless featured_product.available %} disabled{% endunless %}>{% if featured_product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}{%- endform -%}{%- else -%}<a class="pack-button pack-button--pink" href="{{ featured_product.url }}">{{ 'products.product.choose_options' | t }}</a>{%- endif -%}{%- else -%}<h2 class="pack-subheading">{{ 'products.product.select_product' | t }}</h2>{%- endif -%}
    {%- for block in section.blocks -%}{%- case block.type -%}{%- when '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- when 'custom_liquid' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>{%- endcase -%}{%- endfor -%}
  </div>
</div></section>
{% schema %}{"name":"Featured product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured favorite"},{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout","default":true},{"type":"color","id":"background","label":"Background","default":"#FFF8E9"},{"type":"color","id":"text_color","label":"Text","default":"#111111"}],"blocks":[{"type":"@app"},{"type":"custom_liquid","name":"Custom Liquid","settings":[{"type":"liquid","id":"custom_liquid","label":"Custom Liquid"}]}],"presets":[{"name":"Featured product"}]}{% endschema %}
