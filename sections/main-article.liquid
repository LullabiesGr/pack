<article class="standard-page section-pad"><div class="page-width article-page">
  <a class="pack-link" href="{{ blog.url }}">← {{ blog.title }}</a><p class="pack-eyebrow">{{ article.published_at | date: format: 'date' }}{% if section.settings.show_author %} · {{ article.author }}{% endif %}</p><h1 class="pack-heading">{{ article.title }}</h1>
  {%- if article.image -%}<div class="article-page__image">{{ article.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '100vw', loading: 'eager', alt: article.image.alt | default: article.title }}</div>{%- endif -%}
  <div class="rte article-page__body">{{ article.content }}</div>
  {%- if article.tags.size > 0 -%}<div class="article-tags">{%- for tag in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{%- endfor -%}</div>{%- endif -%}
  {%- if blog.comments_enabled? -%}<section class="article-comments"><h2>{{ 'blogs.comments.title' | t }}</h2>{%- paginate article.comments by 10 -%}{%- for comment in article.comments -%}<article class="comment"><p>{{ comment.content }}</p><strong>{{ comment.author }}</strong> · {{ comment.created_at | date: format: 'date' }}</article>{%- endfor -%}{%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}{%- endpaginate -%}
    {%- form 'new_comment', article, class: 'standard-form' -%}{%- if form.posted_successfully? -%}<p class="form-message" role="status">{{ 'blogs.comments.success' | t }}</p>{%- endif -%}{%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}<label for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label><input id="CommentAuthor" name="comment[author]" value="{{ form.author }}" autocomplete="name" required><label for="CommentEmail">{{ 'blogs.comments.email' | t }}</label><input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required><label for="CommentBody">{{ 'blogs.comments.message' | t }}</label><textarea id="CommentBody" name="comment[body]" rows="7" required>{{ form.body }}</textarea><button class="pack-button pack-button--blue" type="submit">{{ 'blogs.comments.post' | t }}</button>{%- endform -%}
  </section>{%- endif -%}
</div></article>
{% schema %}{"name":"Main article","settings":[{"type":"checkbox","id":"show_author","label":"Show author","default":true}]}{% endschema %}
