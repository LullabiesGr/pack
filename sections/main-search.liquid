<section class="main-search section-pad"><div class="page-width">
  <h1 class="main-search__title">{{ 'general.search.search' | t }}</h1>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'general.search.search' | t }}</label><input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off"><input type="hidden" name="options[prefix]" value="last"><button class="pack-button pack-button--blue" type="submit">{{ 'general.search.search' | t }}</button></form>
  {%- if search.performed -%}
    <form class="facets-form search-facets" action="{{ routes.search_url }}" method="get" data-facets-form><input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="options[prefix]" value="last"><div class="collection-toolbar"><span>{{ 'general.search.result_count' | t: count: search.results_count }}</span><div class="collection-toolbar__actions">{%- if section.settings.enable_filtering and search.filters.size > 0 -%}<button class="facets-toggle" type="button" aria-expanded="false" aria-controls="SearchFilters-{{ section.id }}" data-facets-toggle>{{ 'collections.filters.filter' | t }}</button>{%- endif -%}{%- assign sort_by = search.sort_by | default: search.default_sort_by -%}<label class="visually-hidden" for="SearchSort-{{ section.id }}">{{ 'collections.sorting.title' | t }}</label><select id="SearchSort-{{ section.id }}" name="sort_by" data-sort-by>{%- for option in search.sort_options -%}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}</select></div></div>
      {%- if section.settings.enable_filtering and search.filters.size > 0 -%}<div id="SearchFilters-{{ section.id }}" class="facets" data-facets hidden>{%- for filter in search.filters -%}<details class="facet" open><summary>{{ filter.label }}</summary><div class="facet__values">{%- case filter.type -%}{%- when 'boolean', 'list' -%}{%- for value in filter.values -%}<label class="facet__value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label }} ({{ value.count }})</span></label>{%- endfor -%}{%- when 'price_range' -%}<div class="facet__price"><label>{{ 'collections.filters.from' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" value="{% if filter.min_value.value != blank %}{{ filter.min_value.value | divided_by: 100.0 }}{% endif %}"></label><label>{{ 'collections.filters.to' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" value="{% if filter.max_value.value != blank %}{{ filter.max_value.value | divided_by: 100.0 }}{% endif %}"></label></div>{%- endcase -%}</div></details>{%- endfor -%}<div class="facets__actions"><button class="pack-button pack-button--blue" type="submit">{{ 'collections.filters.apply' | t }}</button><a class="pack-link" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}">{{ 'collections.filters.clear' | t }}</a></div></div>{%- endif -%}
    </form>
    {%- paginate search.results by section.settings.results_per_page -%}<div class="search-results product-grid">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{%- capture card_color -%}{% cycle '#F49AC2', '#FFD23F', '#9ED8FF', '#B9E769' %}{%- endcapture -%}{% render 'product-card', product: item, card_color: card_color, index: forloop.index %}{%- else -%}<article class="testimonial-card"><p class="pack-eyebrow">{{ item.object_type }}</p><h2><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncate: 140 }}</p></article>{%- endif -%}{%- else -%}<p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>{%- endfor -%}</div>{%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}{%- endpaginate -%}
  {%- endif -%}
</div></section>
{% schema %}{"name":"Main search","settings":[{"type":"checkbox","id":"enable_filtering","label":"Enable filtering","default":true},{"type":"range","id":"results_per_page","min":6,"max":36,"step":6,"label":"Results per page","default":18}]}{% endschema %}
