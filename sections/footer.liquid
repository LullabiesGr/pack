<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand-wrap">
        {%- if section.settings.footer_logo != blank -%}
          <a class="site-footer__logo" href="{{ routes.root_url }}" style="--footer-logo-width:{{ section.settings.footer_logo_width }}px" aria-label="{{ shop.name | escape }}">
            {{ section.settings.footer_logo | image_url: width: 640 | image_tag: widths: '120, 180, 240, 320, 480, 640', loading: 'lazy', alt: section.settings.footer_logo.alt | default: shop.name }}
          </a>
        {%- elsif section.settings.footer_wordmark != blank -%}
          <a class="site-footer__brand" href="{{ routes.root_url }}">{{ section.settings.footer_wordmark }}</a>
        {%- endif -%}
        <p>{{ section.settings.footer_text }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- else -%}
              <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
              <li><a href="{{ routes.collections_url }}">Collections</a></li>
              <li><a href="{{ routes.search_url }}">Search</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <nav class="social-links" aria-label="{{ 'footer.social_media' | t }}">{%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>{%- endif -%}{%- if section.settings.facebook_url != blank -%}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">{% render 'icon', icon: 'facebook' %}</a>{%- endif -%}{%- if section.settings.tiktok_url != blank -%}<a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">{% render 'icon', icon: 'tiktok' %}</a>{%- endif -%}{%- if section.settings.pinterest_url != blank -%}<a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest">{% render 'icon', icon: 'pinterest' %}</a>{%- endif -%}{%- if section.settings.youtube_url != blank -%}<a href="{{ section.settings.youtube_url }}" aria-label="YouTube">{% render 'icon', icon: 'youtube' %}</a>{%- endif -%}</nav>
    <div class="site-footer__utility">
      {%- if section.settings.show_follow_on_shop -%}<div class="follow-on-shop">{{ shop | login_button: action: 'follow' }}</div>{%- endif -%}
      {%- if localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}<label for="FooterCountry">{{ 'localization.country_label' | t }}</label><select id="FooterCountry" name="country_code" onchange="this.form.submit()">{%- for country in localization.available_countries -%}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{%- endfor -%}</select>{%- endform -%}
      {%- endif -%}
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}<label for="FooterLanguage">{{ 'localization.language_label' | t }}</label><select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">{%- for language in localization.available_languages -%}<option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>{%- endfor -%}</select>{%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="site-footer__bottom">
      {%- if section.settings.show_copyright -%}
        <span>&copy; {% if section.settings.show_current_year %}{{ 'now' | date: '%Y' }} {% endif %}{% if section.settings.copyright_name != blank %}{{ section.settings.copyright_name | escape }}{% else %}{{ shop.name | escape }}{% endif %}{% if section.settings.copyright_text != blank %}. {{ section.settings.copyright_text | escape }}{% endif %}</span>
      {%- endif -%}
      <span>{{ section.settings.footer_note }}</span>
    </div>
  </div>
  {%- if section.settings.show_back_to_top -%}
    <a class="site-footer__back-to-top site-footer__back-to-top--{{ section.settings.back_to_top_style }} site-footer__back-to-top--{{ section.settings.back_to_top_position }}" href="#PageTop" data-back-to-top style="--back-top-bg:{{ section.settings.back_to_top_background }};--back-top-color:{{ section.settings.back_to_top_color }}" aria-label="{{ 'footer.back_to_top' | t }}">
      {% render 'icon', icon: section.settings.back_to_top_style %}
    </a>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "footer_wordmark", "label": "Wordmark", "default": "PALS!" },
    { "type": "image_picker", "id": "footer_logo", "label": "Logo" },
    { "type": "range", "id": "footer_logo_width", "min": 80, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 180 },
    { "type": "textarea", "id": "footer_text", "label": "Description", "default": "Good stuff for great pets." },
    { "type": "text", "id": "footer_note", "label": "Bottom note", "default": "Made for pets and their people." },
    { "type": "header", "content": "Copyright" },
    { "type": "checkbox", "id": "show_copyright", "label": "Show copyright", "default": true },
    { "type": "checkbox", "id": "show_current_year", "label": "Show current year", "default": true },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "info": "Leave blank to use the Shopify store name." },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "All rights reserved." },
    { "type": "header", "content": "Payment icons" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "paragraph", "content": "Displays the full-color payment methods enabled in Shopify Payments settings." },
    { "type": "header", "content": "Back to top" },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show back to top button", "default": true },
    { "type": "select", "id": "back_to_top_style", "label": "Button style", "options": [{ "value": "bone", "label": "Dog bone" }, { "value": "fishbone", "label": "Fish bone" }, { "value": "cat-paw", "label": "Cat paw" }, { "value": "dog-paw", "label": "Dog paw" }, { "value": "arrow-up", "label": "Minimal arrow" }], "default": "bone" },
    { "type": "select", "id": "back_to_top_position", "label": "Position", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" },
    { "type": "color", "id": "back_to_top_background", "label": "Button background", "default": "#FFD23F" },
    { "type": "color", "id": "back_to_top_color", "label": "Button icon", "default": "#111111" },
    { "type": "header", "content": "Social and localization" },
    { "type": "checkbox", "id": "show_follow_on_shop", "label": "Show Follow on Shop", "default": true },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
