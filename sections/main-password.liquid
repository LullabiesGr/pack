<section class="password-page section-pad"><div class="page-width standard-page__narrow"><p class="pack-eyebrow">{{ shop.name }}</p><h1 class="pack-heading">{{ section.settings.heading }}</h1><div class="rte">{{ shop.password_message }}</div>
  {%- form 'storefront_password', class: 'standard-form' -%}{%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}<label for="StorePassword">{{ 'password.general.password' | t }}</label><input id="StorePassword" type="password" name="password" autocomplete="current-password" required><button class="pack-button pack-button--blue" type="submit">{{ 'password.general.enter' | t }}</button>{%- endform -%}
  {%- if section.settings.show_signup -%}{%- form 'customer', class: 'standard-form' -%}<input type="hidden" name="contact[tags]" value="prospect, password page"><label for="PasswordEmail">{{ 'password.general.email' | t }}</label><input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" required><button class="pack-button pack-button--pink" type="submit">{{ 'password.general.notify' | t }}</button>{%- endform -%}{%- endif -%}
</div></section>
{% schema %}{"name":"Password page","settings":[{"type":"text","id":"heading","label":"Heading","default":"Something good is coming"},{"type":"checkbox","id":"show_signup","label":"Show email signup","default":true}]}{% endschema %}
