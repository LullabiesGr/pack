<section class="main-collection">
  <div class="page-width">
    {%- if section.settings.show_collection_image and collection.image != blank -%}<div class="collection-hero-image">{{ collection.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '100vw', loading: 'eager', alt: collection.image.alt | default: collection.title }}</div>{%- endif -%}
    <p class="pack-eyebrow">{{ section.settings.collection_eyebrow }}</p>
    <h1 class="main-collection__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}

    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
    <form class="facets-form" action="{{ collection.url }}" method="get" data-facets-form>
      <div class="collection-toolbar">
        <span role="status">{{ 'collections.general.product_count' | t: count: collection.products_count }}</span>
        <div class="collection-toolbar__actions">
          {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}<button class="facets-toggle" type="button" aria-expanded="false" aria-controls="CollectionFilters-{{ section.id }}" data-facets-toggle>{{ 'collections.filters.filter' | t }}</button>{%- endif -%}
          <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'collections.sorting.title' | t }}</label>
          <select id="SortBy-{{ section.id }}" name="sort_by" data-sort-by>
            {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
          </select>
        </div>
      </div>
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        <div id="CollectionFilters-{{ section.id }}" class="facets" data-facets hidden>
          {%- for filter in collection.filters -%}
            <details class="facet" open>
              <summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
              <div class="facet__values">
                {%- case filter.type -%}
                  {%- when 'boolean', 'list' -%}
                    {%- for value in filter.values -%}
                      <label class="facet__value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label | escape }} ({{ value.count }})</span></label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="facet__price">
                      <label>{{ 'collections.filters.from' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" value="{% if filter.min_value.value != blank %}{{ filter.min_value.value | divided_by: 100.0 }}{% endif %}" placeholder="0"></label>
                      <label>{{ 'collections.filters.to' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" value="{% if filter.max_value.value != blank %}{{ filter.max_value.value | divided_by: 100.0 }}{% endif %}" placeholder="{{ filter.range_max | divided_by: 100.0 }}"></label>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          <div class="facets__actions"><button class="pack-button pack-button--blue" type="submit">{{ 'collections.filters.apply' | t }}</button><a class="pack-link" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.filters.clear' | t }}</a></div>
        </div>
      {%- endif -%}
    </form>

    {%- assign has_active_filters = false -%}
    {%- for filter in collection.filters -%}{%- if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank -%}{%- assign has_active_filters = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_active_filters -%}
      <div class="active-facets" aria-label="{{ 'collections.filters.active' | t }}">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{%- endfor -%}
          {%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != blank or filter.max_value.value != blank -%}<a href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} ×</a>{%- endif -%}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate collection.products by section.settings.collection_products_per_page -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {%- capture card_color -%}{% cycle '#F49AC2', '#FFD23F', '#9ED8FF', '#B9E769', '#F04B32', '#FFF8E9' %}{%- endcapture -%}
          {% render 'product-card', product: product, card_color: card_color, index: forloop.index, interaction_style: section.settings.collection_interaction %}
        {%- else -%}<p>{{ 'collections.general.no_matches' | t }}</p>{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">←</a>{%- endif -%}{%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} class="current" aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}{%- endfor -%}{%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">→</a>{%- endif -%}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Main collection",
  "settings": [
    {"type":"select","id":"collection_interaction","label":"Card hover effect","options":[{"value":"none","label":"None"},{"value":"lift","label":"Lift"},{"value":"tilt","label":"3D tilt"},{"label":"Black offset frame","value":"offset"},{"label":"Soft elevation","value":"soft"},{"label":"Accent outline","value":"outline"},{"label":"Image zoom","value":"zoom"},{"label":"Editorial rotate","value":"rotate"}],"default":"lift"},
    { "type": "text", "id": "collection_eyebrow", "label": "Eyebrow", "default": "Sniff around" },
    { "type": "checkbox", "id": "show_collection_image", "label": "Show collection image", "default": true },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true },
    { "type": "range", "id": "collection_products_per_page", "min": 6, "max": 36, "step": 3, "label": "Products per page", "default": 18 }
  ]
}
{% endschema %}
