<section class="main-collection">
  <div class="page-width">
    <p class="pack-eyebrow">{{ section.settings.collection_eyebrow }}</p>
    <h1 class="main-collection__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}

    <div class="collection-toolbar">
      <span>{{ collection.products_count }} products</span>
      <form method="get">
        <label class="visually-hidden" for="SortBy-{{ section.id }}">Sort</label>
        <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- paginate collection.products by section.settings.collection_products_per_page -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {%- capture card_color -%}{% cycle '#F49AC2', '#FFD23F', '#9ED8FF', '#B9E769', '#F04B32', '#FFF8E9' %}{%- endcapture -%}
          {% render 'product-card', product: product, card_color: card_color, index: forloop.index %}
        {%- else -%}
          <p>No products found.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} class="current"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    { "type": "text", "id": "collection_eyebrow", "label": "Eyebrow", "default": "Sniff around" },
    { "type": "range", "id": "collection_products_per_page", "min": 6, "max": 36, "step": 3, "label": "Products per page", "default": 18 }
  ]
}
{% endschema %}
