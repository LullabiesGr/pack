{%- liquid
  assign hero_product = section.settings.hero_product
  assign hero_collection = section.settings.hero_collection
  assign hero_media = section.settings.hero_image
  assign hero_url = section.settings.hero_button_link
  if hero_media == blank and hero_product != blank
    assign hero_media = hero_product.featured_media
  elsif hero_media == blank and hero_collection != blank
    assign hero_media = hero_collection.image
    if hero_media == blank
      assign hero_media = hero_collection.products.first.featured_media
    endif
  endif
  if hero_url == blank and hero_product != blank
    assign hero_url = hero_product.url
  elsif hero_url == blank and hero_collection != blank
    assign hero_url = hero_collection.url
  endif
  assign hero_url = hero_url | default: routes.all_products_collection_url
  assign hero_motion_class = 'pack-idle pack-idle--' | append: section.settings.hero_idle_motion
-%}
<section class="pack-hero" style="--hero-bg: {{ section.settings.hero_background }}; --hero-text: {{ section.settings.hero_text_color }}">
  <div class="pack-hero__inner page-width">
    <div class="pack-hero__copy"{% if section.settings.hero_copy_animation != 'none' %} data-pack-reveal="{{ section.settings.hero_copy_animation }}"{% endif %}>
      {%- if section.settings.hero_eyebrow != blank -%}<p class="pack-eyebrow">{{ section.settings.hero_eyebrow }}</p>{%- endif -%}
      <h1 class="pack-hero__title">{{ section.settings.hero_heading }}</h1>
      {%- if section.settings.hero_button_label != blank -%}
        <a class="pack-button pack-button--pink" href="{{ hero_url }}">
          {{ section.settings.hero_button_label }} {% render 'icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
    <div class="pack-hero__media"{% if section.settings.hero_media_animation != 'none' %} data-pack-reveal="{{ section.settings.hero_media_animation }}" style="--pack-reveal-delay: var(--pack-motion-stagger)"{% endif %}>
      <span class="pack-hero__treat" aria-hidden="true"></span>
      <div class="pack-hero__badge">{{ section.settings.hero_badge }}</div>
      {%- if hero_media != blank -%}
        {{ hero_media
          | image_url: width: 1600
          | image_tag:
            widths: '500, 750, 1000, 1250, 1600',
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: hero_motion_class,
            alt: hero_media.alt | default: section.settings.hero_heading
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pack-placeholder' }}
      {%- endif -%}
      {%- if section.settings.show_hero_catalog_card and hero_product != blank -%}
        <a class="pack-hero__catalog-card pack-interaction--jelly" href="{{ hero_product.url }}">
          <span>{{ hero_product.title }}</span><strong>{{ hero_product.price | money }}</strong>
        </a>
      {%- elsif section.settings.show_hero_catalog_card and hero_collection != blank -%}
        <a class="pack-hero__catalog-card pack-interaction--jelly" href="{{ hero_collection.url }}">
          <span>{{ hero_collection.title }}</span><strong>{{ hero_collection.products_count }} products</strong>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PACK hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Made for pets with personality" },
    { "type": "inline_richtext", "id": "hero_heading", "label": "Heading", "default": "GOOD STUFF FOR <em>GREAT</em> PETS." },
    { "type": "text", "id": "hero_button_label", "label": "Button label", "default": "Shop the good stuff" },
    { "type": "product", "id": "hero_product", "label": "Featured product" },
    { "type": "collection", "id": "hero_collection", "label": "Featured collection" },
    { "type": "url", "id": "hero_button_link", "label": "Custom button link override" },
    { "type": "image_picker", "id": "hero_image", "label": "Custom hero image override" },
    { "type": "checkbox", "id": "show_hero_catalog_card", "label": "Show linked product or collection card", "default": true },
    { "type": "textarea", "id": "hero_badge", "label": "Badge", "default": "Real ingredients. Wag-worthy results." },
    { "type": "color", "id": "hero_background", "label": "Background", "default": "#0755D9" },
    { "type": "color", "id": "hero_text_color", "label": "Text", "default": "#FFF8E9" },
    { "type": "header", "content": "Animation" },
    { "type": "select", "id": "hero_copy_animation", "label": "Text animation", "options": [
      { "value": "none", "label": "None" }, { "value": "fade-up", "label": "Fade up" }, { "value": "slide-left", "label": "Slide left to right" }, { "value": "pop", "label": "Playful pop" }, { "value": "blur-in", "label": "Candy blur" }, { "value": "flip-up", "label": "Editorial flip" }, { "value": "squish", "label": "Playful squish" }
    ], "default": "none" },
    { "type": "select", "id": "hero_media_animation", "label": "Image animation", "options": [
      { "value": "none", "label": "None" }, { "value": "slide-right", "label": "Slide right to left" }, { "value": "slide-left", "label": "Slide left to right" }, { "value": "zoom-in", "label": "Zoom in" }, { "value": "fade-in", "label": "Fade in" }, { "value": "blur-in", "label": "Candy blur" }, { "value": "flip-up", "label": "Editorial flip" }, { "value": "squish", "label": "Playful squish" }
    ], "default": "none" },
    { "type": "select", "id": "hero_idle_motion", "label": "Continuous image motion", "options": [
      { "value": "none", "label": "None" }, { "value": "float", "label": "Gentle float" }, { "value": "sway", "label": "Sway" }, { "value": "bounce", "label": "Soft bounce" }, { "value": "orbit", "label": "Mini orbit" }
    ], "default": "none" }
  ],
  "presets": [{ "name": "PACK hero" }]
}
{% endschema %}
