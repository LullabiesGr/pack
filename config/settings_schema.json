[
  {
    "name": "theme_info",
    "theme_name": "PACK",
    "theme_version": "1.0.0",
    "theme_author": "LullabiesGr",
    "theme_documentation_url": "https://github.com/LullabiesGr/pack",
    "theme_support_url": "https://github.com/LullabiesGr/pack/issues"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "color", "id": "color_primary", "label": "Cobalt", "default": "#0755D9" },
      { "type": "color", "id": "color_secondary", "label": "Butter yellow", "default": "#FFD23F" },
      { "type": "color", "id": "color_accent", "label": "Bubblegum pink", "default": "#F49AC2" },
      { "type": "color", "id": "color_green", "label": "Pistachio", "default": "#B9E769" },
      { "type": "color", "id": "color_red", "label": "Tomato", "default": "#F04B32" },
      { "type": "color", "id": "color_background", "label": "Cream", "default": "#FFF8E9" },
      { "type": "color", "id": "color_text", "label": "Ink", "default": "#111111" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "type_display_font", "label": "Display font", "default": "assistant_n7" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body font", "default": "assistant_n4" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1080, "max": 1600, "step": 40, "unit": "px", "label": "Page width", "default": 1360 },
      { "type": "range", "id": "card_radius", "min": 0, "max": 36, "step": 2, "unit": "px", "label": "Card corner radius", "default": 18 }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show vendor", "default": false },
      { "type": "checkbox", "id": "card_enable_quick_add", "label": "Enable quick add", "default": true },
      { "type": "checkbox", "id": "card_show_sale_badge", "label": "Show sale badge", "default": true }
    ]
  },
  {
    "name": "Playful details",
    "settings": [
      { "type": "header", "content": "Paw trail" },
      { "type": "checkbox", "id": "show_paw_trail", "label": "Show decorative paw trail", "default": false },
      {
        "type": "select",
        "id": "paw_trail_position",
        "label": "Paw trail position",
        "options": [
          { "value": "left", "label": "Left edge" },
          { "value": "right", "label": "Right edge" },
          { "value": "both", "label": "Both edges" }
        ],
        "default": "right"
      },
      { "type": "color", "id": "paw_trail_color", "label": "Paw trail color", "default": "#FFD23F" },
      { "type": "range", "id": "paw_trail_opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Paw trail opacity", "default": 65 },
      { "type": "checkbox", "id": "animate_paw_trail", "label": "Animate paw trail", "default": true },
      { "type": "header", "content": "Corner doodles" },
      { "type": "checkbox", "id": "show_corner_doodles", "label": "Show corner doodles", "default": false },
      {
        "type": "select",
        "id": "corner_doodle_style",
        "label": "Doodle style",
        "options": [
          { "value": "bones", "label": "Bones" },
          { "value": "hearts", "label": "Hearts" },
          { "value": "mixed", "label": "Bones and hearts" }
        ],
        "default": "mixed"
      },
      { "type": "color", "id": "corner_doodle_color", "label": "Doodle color", "default": "#F49AC2" },
      { "type": "header", "content": "Cart styling" },
      {
        "type": "select",
        "id": "cart_icon_style",
        "label": "Header cart icon",
        "options": [
          { "value": "standard", "label": "Standard cart" },
          { "value": "doghouse", "label": "Doghouse" }
        ],
        "default": "standard"
      },
      {
        "type": "select",
        "id": "cart_page_style",
        "label": "Cart summary shape",
        "options": [
          { "value": "standard", "label": "Standard card" },
          { "value": "doghouse", "label": "Doghouse" }
        ],
        "default": "standard"
      },
      { "type": "checkbox", "id": "show_button_paws", "label": "Show paw detail on buttons", "default": false }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      { "type": "paragraph", "content": "Animations remain off until an animation style is selected inside a section." },
      { "type": "range", "id": "motion_duration", "min": 400, "max": 1200, "step": 100, "unit": "ms", "label": "Animation duration", "default": 700 },
      { "type": "range", "id": "motion_distance", "min": 20, "max": 120, "step": 10, "unit": "px", "label": "Slide distance", "default": 60 },
      { "type": "range", "id": "motion_stagger", "min": 40, "max": 200, "step": 20, "unit": "ms", "label": "Stagger between items", "default": 100 },
      {
        "type": "select",
        "id": "motion_easing",
        "label": "Motion feel",
        "options": [
          { "value": "smooth", "label": "Smooth" },
          { "value": "snappy", "label": "Snappy" },
          { "value": "playful", "label": "Playful" }
        ],
        "default": "smooth"
      },
      { "type": "checkbox", "id": "motion_repeat", "label": "Repeat when elements re-enter the screen", "default": false }
    ]
  }
]
